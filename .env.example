# Copy to .env for local development. Every value here is a default that works
# without credentials, because the default registry enables only the mock
# provider.

LLM_FABRIC_HOST=127.0.0.1
LLM_FABRIC_PORT=47317
LLM_FABRIC_LOG_LEVEL=INFO

# development | test | production
# Required. Unset, empty, or any other value is a startup failure — the process
# will not quietly become development.
LLM_FABRIC_ENVIRONMENT=development

LLM_FABRIC_REGISTRY_PATH=config/models.yaml

# ---------------------------------------------------------------------------
# Identity
#
# In development and test, an empty credential set plus ALLOW_ANONYMOUS=true
# (the default) admits an anonymous principal. That combination is refused
# in production — the process exits before binding a port.
#   disabled | api_key | dev | oidc
LLM_FABRIC_AUTH_MODE=

# Explicit anonymous bypass. Required to start without credentials when
# ENVIRONMENT is development or test and you have set ALLOW_ANONYMOUS=false.
# Production rejects this flag even if it is true in a copied .env.
LLM_FABRIC_ALLOW_ANONYMOUS=true

# Scopes every accepted token must carry. Empty means no global floor; routes
# still enforce their own scope checks.
LLM_FABRIC_REQUIRED_SCOPES=

# --- Production: OAuth2 / OIDC ---
# Both are required for oidc mode. The audience must be pinned, otherwise any
# token the issuer ever minted is replayable against this gateway.
LLM_FABRIC_OIDC_ISSUER=
LLM_FABRIC_OIDC_AUDIENCE=
# Optional. Discovered from the issuer's well-known document when unset.
LLM_FABRIC_OIDC_JWKS_URI=
LLM_FABRIC_OIDC_JWKS_CACHE_SECONDS=300

# Claim names differ between issuers. These are the defaults.
LLM_FABRIC_CLAIM_TENANT=tenant_id
LLM_FABRIC_CLAIM_USER=user_id
LLM_FABRIC_CLAIM_PROJECT=project_id
LLM_FABRIC_CLAIM_ROLES=roles
LLM_FABRIC_CLAIM_SCOPES=scope

# --- Machine callers: static keys bound to a tenant ---
# JSON list. Keys must be at least 16 characters: a static key is a bearer
# credential with no expiry, so it has to carry its entropy on its own.
# [{"key":"...","tenant_id":"acme","user_id":"svc","scopes":["chat:write"]}]
LLM_FABRIC_API_CREDENTIALS=

# Legacy flat list, comma-separated. Carries no tenant of its own, so every key
# lands in the "default" tenant. Prefer LLM_FABRIC_API_CREDENTIALS.
LLM_FABRIC_API_KEYS=

# --- Local development issuer ---
# Mints a token for ANY identity requested. Must be at least 32 characters, and
# must never be set in production.
LLM_FABRIC_DEV_AUTH_SECRET=

# Tenant assigned to callers when authentication is disabled entirely.
LLM_FABRIC_ANONYMOUS_TENANT=public

# ---------------------------------------------------------------------------
# Distributed state
#
# Unset keeps records, quotas and revocation in this process. Production
# refuses to start unless both URLs are set and reachable.
LLM_FABRIC_DATABASE_URL=
LLM_FABRIC_REDIS_URL=
# Background dependency probes. /readyz and admission read cached state.
# Detection bound is fail_threshold * (interval + timeout) seconds.
# A serving-path failure marks the dependency unhealthy immediately.
LLM_FABRIC_HEALTH_PROBE_INTERVAL_S=2
LLM_FABRIC_HEALTH_PROBE_TIMEOUT_S=1
LLM_FABRIC_HEALTH_FAIL_THRESHOLD=2
LLM_FABRIC_HEALTH_RECOVERY_THRESHOLD=2
# Analytical store (ClickHouse). Never on the request path.
LLM_FABRIC_ANALYTICS_URL=

# ---------------------------------------------------------------------------
# Quotas
#
# Empty means unlimited. Redis-backed when LLM_FABRIC_REDIS_URL is set, so
# every worker shares one ceiling.
LLM_FABRIC_QUOTA_TENANT_REQUESTS_PER_MINUTE=
LLM_FABRIC_QUOTA_TENANT_REQUESTS_PER_DAY=
LLM_FABRIC_QUOTA_TENANT_TOKENS_PER_DAY=
LLM_FABRIC_QUOTA_TENANT_COST_PER_DAY_USD=

LLM_FABRIC_QUOTA_USER_REQUESTS_PER_MINUTE=
LLM_FABRIC_QUOTA_USER_REQUESTS_PER_DAY=
LLM_FABRIC_QUOTA_USER_TOKENS_PER_DAY=
LLM_FABRIC_QUOTA_USER_COST_PER_DAY_USD=

# ---------------------------------------------------------------------------
# Inference

# Per-attempt timeout, and total attempts across a fallback chain.
LLM_FABRIC_REQUEST_TIMEOUT_S=60
LLM_FABRIC_MAX_ATTEMPTS=3

# Policy used by aliases that do not name one themselves. One of:
# quality_first | latency_first | cost_first | balanced | local_only |
# private_only | declared. The legacy name `cheapest` still means `cost_first`.
LLM_FABRIC_DEFAULT_POLICY=cost_first

# Required only once the matching provider is enabled in the registry.
# Unprefixed OPENAI_API_KEY / ANTHROPIC_API_KEY are also accepted.
LLM_FABRIC_OPENAI_API_KEY=
LLM_FABRIC_ANTHROPIC_API_KEY=

# ---------------------------------------------------------------------------
# Serving

# Sockets accepted but not yet served, and requests a worker handles before it
# is replaced. Empty max-requests disables recycling.
LLM_FABRIC_BACKLOG=2048
LLM_FABRIC_MAX_REQUESTS_PER_WORKER=

# Worker processes. Leave unset for one worker, which is the ONLY configuration
# whose quotas mean what they say: the quota ledger, circuit breakers, usage
# meter and caches all live in the serving process, so N workers enforce every
# limit N times over. Starting with more than one worker is refused unless the
# consequence is acknowledged below. A single worker sustained 1000 req/s in
# docs/BENCHMARKS.md, so this is rarely the right lever.
LLM_FABRIC_WORKERS=
LLM_FABRIC_ALLOW_UNSAFE_MULTIWORKER=false

# ---------------------------------------------------------------------------
# Routing reliability

# Circuit breaker. A deployment trips after this many consecutive failures, or
# once its observed error rate exceeds the threshold over at least the minimum
# sample. It stays open for the cooldown, then admits half-open probes and needs
# this many successes to close again.
LLM_FABRIC_BREAKER_CONSECUTIVE_FAILURES=5
LLM_FABRIC_BREAKER_ERROR_RATE=0.5
LLM_FABRIC_BREAKER_MINIMUM_SAMPLES=10
LLM_FABRIC_BREAKER_OPEN_DURATION_S=30
LLM_FABRIC_BREAKER_HALF_OPEN_SUCCESSES=2

# In-flight requests one deployment may hold. Empty means unlimited, which is
# the honest default for a fleet whose capacity has not been measured.
LLM_FABRIC_BREAKER_MAX_CONCURRENCY=

# Ceilings on what falling back may consume, beyond LLM_FABRIC_MAX_ATTEMPTS.
# Empty means the attempt limit is the only bound.
LLM_FABRIC_FALLBACK_MAX_COST_USD=
LLM_FABRIC_FALLBACK_MAX_LATENCY_MS=

# ---------------------------------------------------------------------------
# Intent classification

# Off by default: classifying every prompt on the serving path costs latency
# that has not been measured. When enabled, the router may infer a policy from
# the classification, and responses carry x-fabric-intent headers.
LLM_FABRIC_INTENT_CLASSIFICATION_ENABLED=false
# Classify without changing the route. Recorded on x-fabric-intent-shadow-* headers.
# Ignored when classification is enabled (that path is authoritative).
LLM_FABRIC_INTENT_SHADOW=false
# hashing (default, CI) | local / bge-small | minilm
# local requires the optional extra: uv sync --extra embed
LLM_FABRIC_INTENT_EMBEDDER=hashing
# Local description reranker as L4. L5 stays off.
LLM_FABRIC_INTENT_L4_RERANK=false

# ---------------------------------------------------------------------------
# Observability
#
# OTLP HTTP traces URL (http://otel-collector:4318/v1/traces). A host:port
# base is accepted and /v1/traces is appended. Empty means spans stay in this
# process for the Command Center and are never shipped. Headers/certificates:
# LLM_FABRIC_OTEL_EXPORTER_OTLP_HEADERS, LLM_FABRIC_OTEL_EXPORTER_OTLP_CERTIFICATE.
LLM_FABRIC_OTEL_EXPORTER_OTLP_ENDPOINT=

# Langfuse. All three must be set or the adapter is a no-op. A missing Langfuse
# never fails a request.
LLM_FABRIC_LANGFUSE_HOST=
LLM_FABRIC_LANGFUSE_PUBLIC_KEY=
LLM_FABRIC_LANGFUSE_SECRET_KEY=
