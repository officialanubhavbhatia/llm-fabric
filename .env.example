# Copy to .env for local development. Every value here is a default that works
# without credentials, because the default registry enables only the mock
# provider.

LLM_FABRIC_HOST=127.0.0.1
LLM_FABRIC_PORT=47317
LLM_FABRIC_LOG_LEVEL=INFO

LLM_FABRIC_REGISTRY_PATH=config/models.yaml

# Comma-separated client keys. Leave empty and the gateway runs open, which is
# logged as a warning at startup. Set it for anything but local use.
LLM_FABRIC_API_KEYS=

# Per-attempt timeout, and total attempts across a fallback chain.
LLM_FABRIC_REQUEST_TIMEOUT_S=60
LLM_FABRIC_MAX_ATTEMPTS=3

# Policy used by aliases that do not name one themselves: cheapest | declared
LLM_FABRIC_DEFAULT_POLICY=cheapest

# Required only once the matching provider is enabled in the registry.
LLM_FABRIC_OPENAI_API_KEY=
LLM_FABRIC_ANTHROPIC_API_KEY=
